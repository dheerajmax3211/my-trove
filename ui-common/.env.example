# Copy to .env.local in the app that uses @platform/auth-web (Vite exposes VITE_* to the browser).
# These are Firebase *web* config values: identifiers, not secrets, but still keep real values
# out of git. Never put service-account keys or admin credentials in a frontend env file.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Local development against the Firebase Auth emulator (`firebase emulators:start --only auth`).
# When set, apiKey/projectId may be omitted (demo values are used) and no real project is touched.
# VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
