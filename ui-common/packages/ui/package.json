{
  "name": "@platform/ui",
  "version": "0.1.0",
  "description": "Accessible React 19 component library built on Radix primitives and @platform/tokens.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "@platform/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": {
      "@platform/source": "./src/styles/base.css",
      "default": "./dist/styles.css"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@platform/tokens": "workspace:*",
    "radix-ui": "1.8.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
