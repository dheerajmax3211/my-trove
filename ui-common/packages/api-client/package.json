{
  "name": "@platform/api-client",
  "version": "0.1.0",
  "description": "Typed fetch wrapper (Bearer auth, 401 refresh-retry, RFC 7807 errors) plus TanStack Query helpers.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "@platform/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@tanstack/react-query": "5.108.3",
    "react": "19.3.1",
    "tsup": "9.0.0"
  }
}
