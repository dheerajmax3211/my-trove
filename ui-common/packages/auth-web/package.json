{
  "name": "@platform/auth-web",
  "version": "0.1.0",
  "description": "Firebase Auth wrapper for web: AuthProvider, hooks, route guard, emulator support.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    ".env.example"
  ],
  "exports": {
    ".": {
      "@platform/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "firebase": "13.4.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "react": "19.3.1",
    "tsup": "9.0.0"
  }
}
