# Local development against the real services with no Firebase project: run dev/up.sh (see ../../../dev/README.md)
# and set this. It takes precedence over the Firebase and emulator settings below.
# VITE_DEV_IDP_URL=http://localhost:9100

# Copy to .env.local. Everything here is optional: with no Firebase config the hub runs in
# demo mode (in-memory mock backend, switchable demo users) and needs no server at all.

# Force demo mode even when Firebase is configured.
# VITE_USE_MOCK=true

# Root of the API gateway. The hub calls `${VITE_API_BASE_URL}/auth/v1/...` (auth-service) and
# `${VITE_API_BASE_URL}/shared/v1/...` (shared-service). Default: /api, which the Vite dev server
# proxies to localhost:8081 (auth) and localhost:8082 (shared).
# VITE_API_BASE_URL=/api

# Firebase web config (identifiers, not secrets). Setting these switches the hub to live mode.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Local development against the Firebase Auth emulator (VITE_AUTH_EMULATOR_HOST is accepted as an alias).
# VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Where the launcher cards link to.
# VITE_APP_URL_WAITING_ON=http://localhost:5182
# VITE_APP_URL_CONSENT=http://localhost:5183
# VITE_APP_URL_HOME_PULSE=http://localhost:5184
# VITE_APP_URL_ASK_YOUR_LIFE=http://localhost:5185
# VITE_APP_URL_DIGITAL_LEGACY=http://localhost:5186
# VITE_APP_URL_FAMILY_TREASURY=http://localhost:5187
