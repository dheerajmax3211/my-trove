# Local development against the real services with no Firebase project: run dev/up.sh (see ../../../dev/README.md)
# and set this. It takes precedence over the Firebase and emulator settings below.
# VITE_DEV_IDP_URL=http://localhost:9100

# Copy to .env.local. With none of these set the app runs in demo mode: stub sign-in and an
# in-memory mock of the digital-legacy service. Nothing here is a secret.

# Real mode needs a Firebase web config (see the root .env.example) and the service running:
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Where the API lives. Default `/api`, which the Vite dev server proxies to http://localhost:8087.
# VITE_API_BASE_URL=/api

# Force the in-memory mock API even when Firebase is configured.
# VITE_USE_MOCK=true
