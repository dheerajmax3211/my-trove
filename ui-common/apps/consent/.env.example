# Local development against the real services with no Firebase project: run dev/up.sh (see ../../../dev/README.md)
# and set this. It takes precedence over the Firebase and emulator settings below.
# VITE_DEV_IDP_URL=http://localhost:9100

# Zero-setup demo: in-memory stub sign-in and in-memory mock gateway. This is the default when
# no Firebase config is present, so you can leave everything below unset.
# VITE_USE_MOCK=true

# Real mode: Firebase Auth (or its emulator) plus the consent gateway.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Firebase Auth emulator, e.g. 127.0.0.1:9099 (fills in demo key/project id when unset)
VITE_FIREBASE_AUTH_EMULATOR_HOST=

# Where the consent gateway lives. Leave unset to use the dev proxy: /api -> http://localhost:8084
# (the gateway has no CORS configuration, so an absolute URL only works behind a same-origin proxy).
VITE_API_BASE_URL=
