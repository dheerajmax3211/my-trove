# Local development against the real services with no Firebase project: run dev/up.sh (see ../../../dev/README.md)
# and set this. It takes precedence over the Firebase and emulator settings below.
# VITE_DEV_IDP_URL=http://localhost:9100

# Demo mode is the default: with nothing below set, the app runs against an in-memory mock API
# and a stub sign-in, so `pnpm --filter @platform/home-pulse dev` works with zero setup.

# Force the in-memory mock API + stub auth even when Firebase is configured.
# VITE_USE_MOCK=true

# Real backend. Leave unset to use the dev proxy: /api -> http://localhost:8085 (see vite.config.ts).
# VITE_API_BASE_URL=http://localhost:8085

# Firebase Auth (a real project, or the emulator). Setting either of these switches off demo mode.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
