# Local development against the real services with no Firebase project: run dev/up.sh (see ../../../dev/README.md)
# and set this. It takes precedence over the Firebase and emulator settings below.
# VITE_DEV_IDP_URL=http://localhost:9100

# Copy to .env.local. With none of the VITE_FIREBASE_* values set, the app runs in demo mode: an in-memory
# mock of the family-treasury API and a persona picker instead of Firebase sign-in. No backend needed.

# Force a mode explicitly: "true" = demo (mock API + persona sign-in), "false" = real backend + Firebase.
# VITE_USE_MOCK=true

# --- Real mode: Firebase Auth (emulator or a real project) ---
# VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=

# --- Real mode: backend origin. "/v1" is appended. Leave unset in dev to use the Vite proxy
# (/api -> http://localhost:8088). ---
# VITE_API_BASE_URL=http://localhost:8088
