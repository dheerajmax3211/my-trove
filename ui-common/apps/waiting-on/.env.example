# Local development against the real services with no Firebase project: run dev/up.sh (see ../../../dev/README.md)
# and set this. It takes precedence over the Firebase and emulator settings below.
# VITE_DEV_IDP_URL=http://localhost:9100

# Demo mode (default): leave everything unset. The app uses a stub sign-in and an in-memory mock API.
# Force demo mode even when Firebase is configured:
# VITE_USE_MOCK=true

# Real mode: set the Firebase web config (or just the emulator host) and the app talks to the
# waiting-on service (port 8083). In dev the Vite proxy forwards /api to http://localhost:8083.
# VITE_API_BASE_URL=/api
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
