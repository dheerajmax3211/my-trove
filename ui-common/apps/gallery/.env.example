# Copy to .env.local. With none of these set, the gallery's demo uses a built-in stub auth
# client and an in-memory mock API, so it works offline with zero setup.

# --- Option A: Firebase Auth emulator (recommended for local development) ---
# Run: firebase emulators:start --only auth
# VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# --- Option B: a real Firebase project (web config values, not secrets) ---
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=

# --- API: point the demo at a real backend instead of the in-memory mock ---
# VITE_API_BASE_URL=http://localhost:8080
