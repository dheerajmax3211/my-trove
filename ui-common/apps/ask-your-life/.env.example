# Local development against the real services with no Firebase project: run dev/up.sh (see ../../../dev/README.md)
# and set this. It takes precedence over the Firebase and emulator settings below.
# VITE_DEV_IDP_URL=http://localhost:9100

# Copy to .env.local. With none of these set the app runs in DEMO MODE: a stub sign-in and an
# in-memory mock of the ask-your-life API, so it works offline with zero setup.

# Force demo mode even if Firebase is configured (default: demo whenever Firebase is not configured).
# VITE_USE_MOCK=true

# --- Real mode: Firebase Auth emulator (recommended for local development) ---
# VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# --- Real mode: a real Firebase project (web config values, not secrets) ---
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=

# --- API base URL. Default /api, which the Vite dev server proxies to http://localhost:8086
# (the ask-your-life service) with the /api prefix removed. ---
# VITE_API_BASE_URL=/api
