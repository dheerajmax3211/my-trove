<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.2</version>
		<relativePath/>
	</parent>

	<groupId>com.personalplatform</groupId>
	<artifactId>platform-parent</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>platform-parent</name>
	<description>Parent and aggregator for the personal platform backend services</description>

	<modules>
		<module>sql-jooq</module>
		<module>libs/platform-security</module>
		<module>libs/platform-notify</module>
		<module>auth</module>
		<module>shared-service</module>
		<module>waiting-on</module>
		<module>consent-gateway</module>
		<module>home-pulse</module>
		<module>ask-your-life</module>
		<module>digital-legacy</module>
		<module>family-treasury</module>
		<module>platform-service</module>
		<module>mcp-server</module>
		<module>gateway</module>
	</modules>

	<properties>
		<java.version>21</java.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>com.personalplatform</groupId>
				<artifactId>platform-sql</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.personalplatform</groupId>
				<artifactId>platform-security</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.personalplatform</groupId>
				<artifactId>platform-notify</artifactId>
				<version>${project.version}</version>
			</dependency>
			<!-- Security pins for transitive dependencies (found by OSV-Scanner on the images; CI's Trivy gate failed on
			     them). Remove a pin once the dependency that brings it in ships the fixed version itself. -->
			<!-- kafka-clients 4.x brings lz4-java 1.11.2 and snappy-java 1.1.10.7 (HIGH: GHSA-343h-94h5-c4wr, GHSA-gwq9-9ffj-mvrv) -->
			<dependency>
				<groupId>at.yawk.lz4</groupId>
				<artifactId>lz4-java</artifactId>
				<version>1.11.4</version>
			</dependency>
			<dependency>
				<groupId>org.xerial.snappy</groupId>
				<artifactId>snappy-java</artifactId>
				<version>1.1.10.9</version>
			</dependency>
			<!-- temporal-sdk brings guava 33.4.8-android (HIGH: GHSA-xxph-c9ww-hj94) -->
			<dependency>
				<groupId>com.google.guava</groupId>
				<artifactId>guava</artifactId>
				<version>33.7.2-android</version>
			</dependency>
		</dependencies>
	</dependencyManagement>
</project>
