<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.2</version>
		<relativePath/>
	</parent>

	<groupId>com.personalplatform</groupId>
	<artifactId>platform-parent</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>platform-parent</name>
	<description>Parent and aggregator for the personal platform backend services</description>

	<modules>
		<module>sql-jooq</module>
		<module>libs/platform-security</module>
		<module>auth</module>
		<module>shared-service</module>
		<module>waiting-on</module>
		<module>consent-gateway</module>
		<module>home-pulse</module>
		<module>ask-your-life</module>
		<module>digital-legacy</module>
		<module>family-treasury</module>
	</modules>

	<properties>
		<java.version>21</java.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>com.personalplatform</groupId>
				<artifactId>platform-sql</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.personalplatform</groupId>
				<artifactId>platform-security</artifactId>
				<version>${project.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>
</project>
