<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.personalplatform</groupId>
		<artifactId>platform-parent</artifactId>
		<version>0.0.1-SNAPSHOT</version>
		<relativePath>../pom.xml</relativePath>
	</parent>

	<artifactId>platform-sql</artifactId>
	<name>platform-sql</name>
	<description>Schema migrations (Flyway), generated jOOQ classes and shared SQL helpers</description>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-jooq</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!--
				One execution per schema. Each service owns one Postgres schema; its migrations live in
				src/main/resources/db/migration/<schema>/ and its jOOQ classes are generated from them.
				To add a schema: add its migration folder, then copy this execution with a new id/scripts/package.
			-->
			<plugin>
				<groupId>org.jooq</groupId>
				<artifactId>jooq-codegen-maven</artifactId>
				<version>${jooq.version}</version>
				<dependencies>
					<dependency>
						<groupId>org.jooq</groupId>
						<artifactId>jooq-meta-extensions</artifactId>
						<version>${jooq.version}</version>
					</dependency>
				</dependencies>
				<executions>
					<execution>
						<id>generate-auth</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<generator>
								<database>
									<name>org.jooq.meta.extensions.ddl.DDLDatabase</name>
									<includes>.*</includes>
									<excludes>flyway_schema_history</excludes>
									<properties>
										<property>
											<key>scripts</key>
											<value>src/main/resources/db/migration/auth/*.sql</value>
										</property>
										<property>
											<key>sort</key>
											<value>flyway</value>
										</property>
										<property>
											<key>unqualifiedSchema</key>
											<value>none</value>
										</property>
										<property>
											<key>defaultNameCase</key>
											<value>lower</value>
										</property>
									</properties>
								</database>
								<target>
									<packageName>com.personalplatform.sql.jooq.auth</packageName>
									<directory>target/generated-sources/jooq/auth</directory>
								</target>
							</generator>
						</configuration>
					</execution>
					<execution>
						<id>generate-shared</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<generator>
								<database>
									<name>org.jooq.meta.extensions.ddl.DDLDatabase</name>
									<includes>.*</includes>
									<excludes>flyway_schema_history</excludes>
									<properties>
										<property>
											<key>scripts</key>
											<value>src/main/resources/db/migration/shared/*.sql</value>
										</property>
										<property>
											<key>sort</key>
											<value>flyway</value>
										</property>
										<property>
											<key>unqualifiedSchema</key>
											<value>none</value>
										</property>
										<property>
											<key>defaultNameCase</key>
											<value>lower</value>
										</property>
									</properties>
									<forcedTypes>
										<!-- DDLDatabase reads jsonb as json; the real column is jsonb -->
										<forcedType>
											<name>JSONB</name>
											<includeTypes>(?i:json)</includeTypes>
										</forcedType>
									</forcedTypes>
								</database>
								<target>
									<packageName>com.personalplatform.sql.jooq.shared</packageName>
									<directory>target/generated-sources/jooq/shared</directory>
								</target>
							</generator>
						</configuration>
					</execution>
					<execution>
						<id>generate-waiting_on</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<generator>
								<database>
									<name>org.jooq.meta.extensions.ddl.DDLDatabase</name>
									<includes>.*</includes>
									<excludes>flyway_schema_history</excludes>
									<properties>
										<property>
											<key>scripts</key>
											<value>src/main/resources/db/migration/waiting_on/*.sql</value>
										</property>
										<property>
											<key>sort</key>
											<value>flyway</value>
										</property>
										<property>
											<key>unqualifiedSchema</key>
											<value>none</value>
										</property>
										<property>
											<key>defaultNameCase</key>
											<value>lower</value>
										</property>
									</properties>
								</database>
								<target>
									<packageName>com.personalplatform.sql.jooq.waiting_on</packageName>
									<directory>target/generated-sources/jooq/waiting_on</directory>
								</target>
							</generator>
						</configuration>
					</execution>
					<execution>
						<id>generate-consent</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<generator>
								<database>
									<name>org.jooq.meta.extensions.ddl.DDLDatabase</name>
									<includes>.*</includes>
									<excludes>flyway_schema_history</excludes>
									<properties>
										<property>
											<key>scripts</key>
											<value>src/main/resources/db/migration/consent/*.sql</value>
										</property>
										<property>
											<key>sort</key>
											<value>flyway</value>
										</property>
										<property>
											<key>unqualifiedSchema</key>
											<value>none</value>
										</property>
										<property>
											<key>defaultNameCase</key>
											<value>lower</value>
										</property>
									</properties>
								</database>
								<target>
									<packageName>com.personalplatform.sql.jooq.consent</packageName>
									<directory>target/generated-sources/jooq/consent</directory>
								</target>
							</generator>
						</configuration>
					</execution>
					<execution>
						<id>generate-home_pulse</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<generator>
								<database>
									<name>org.jooq.meta.extensions.ddl.DDLDatabase</name>
									<includes>.*</includes>
									<excludes>flyway_schema_history</excludes>
									<properties>
										<property>
											<key>scripts</key>
											<value>src/main/resources/db/migration/home_pulse/*.sql</value>
										</property>
										<property>
											<key>sort</key>
											<value>flyway</value>
										</property>
										<property>
											<key>unqualifiedSchema</key>
											<value>none</value>
										</property>
										<property>
											<key>defaultNameCase</key>
											<value>lower</value>
										</property>
									</properties>
								</database>
								<target>
									<packageName>com.personalplatform.sql.jooq.home_pulse</packageName>
									<directory>target/generated-sources/jooq/home_pulse</directory>
								</target>
							</generator>
						</configuration>
					</execution>
					<execution>
						<id>generate-ask_life</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<generator>
								<database>
									<name>org.jooq.meta.extensions.ddl.DDLDatabase</name>
									<includes>.*</includes>
									<excludes>flyway_schema_history</excludes>
									<properties>
										<property>
											<key>scripts</key>
											<value>src/main/resources/db/migration/ask_life/*.sql</value>
										</property>
										<property>
											<key>sort</key>
											<value>flyway</value>
										</property>
										<property>
											<key>unqualifiedSchema</key>
											<value>none</value>
										</property>
										<property>
											<key>defaultNameCase</key>
											<value>lower</value>
										</property>
									</properties>
								</database>
								<target>
									<packageName>com.personalplatform.sql.jooq.ask_life</packageName>
									<directory>target/generated-sources/jooq/ask_life</directory>
								</target>
							</generator>
						</configuration>
					</execution>
					<execution>
						<id>generate-legacy</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<generator>
								<database>
									<name>org.jooq.meta.extensions.ddl.DDLDatabase</name>
									<includes>.*</includes>
									<excludes>flyway_schema_history</excludes>
									<properties>
										<property>
											<key>scripts</key>
											<value>src/main/resources/db/migration/legacy/*.sql</value>
										</property>
										<property>
											<key>sort</key>
											<value>flyway</value>
										</property>
										<property>
											<key>unqualifiedSchema</key>
											<value>none</value>
										</property>
										<property>
											<key>defaultNameCase</key>
											<value>lower</value>
										</property>
									</properties>
									<!-- the DDL is parsed in H2 where jsonb reads as json; the real column is jsonb -->
									<forcedTypes>
										<forcedType>
											<name>JSONB</name>
											<includeTypes>(?i:JSON)</includeTypes>
										</forcedType>
									</forcedTypes>
								</database>
								<target>
									<packageName>com.personalplatform.sql.jooq.legacy</packageName>
									<directory>target/generated-sources/jooq/legacy</directory>
								</target>
							</generator>
						</configuration>
					</execution>
					<execution>
						<id>generate-treasury</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<generator>
								<database>
									<name>org.jooq.meta.extensions.ddl.DDLDatabase</name>
									<includes>.*</includes>
									<excludes>flyway_schema_history</excludes>
									<properties>
										<property>
											<key>scripts</key>
											<value>src/main/resources/db/migration/treasury/*.sql</value>
										</property>
										<property>
											<key>sort</key>
											<value>flyway</value>
										</property>
										<property>
											<key>unqualifiedSchema</key>
											<value>none</value>
										</property>
										<property>
											<key>defaultNameCase</key>
											<value>lower</value>
										</property>
									</properties>
								</database>
								<target>
									<packageName>com.personalplatform.sql.jooq.treasury</packageName>
									<directory>target/generated-sources/jooq/treasury</directory>
								</target>
							</generator>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>build-helper-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>add-generated-jooq</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>add-source</goal>
						</goals>
						<configuration>
							<sources>
								<source>target/generated-sources/jooq/auth</source>
								<source>target/generated-sources/jooq/shared</source>
								<source>target/generated-sources/jooq/waiting_on</source>
								<source>target/generated-sources/jooq/consent</source>
								<source>target/generated-sources/jooq/home_pulse</source>
								<source>target/generated-sources/jooq/ask_life</source>
								<source>target/generated-sources/jooq/legacy</source>
								<source>target/generated-sources/jooq/treasury</source>
							</sources>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
