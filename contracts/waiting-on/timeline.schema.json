{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Waiting On item timeline (ItemController.TimelineResponse[])",
  "description": "GET /v1/items/{id}/timeline.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "type", "summary", "detail", "occurredAt"],
    "properties": {
      "id": { "type": "string" },
      "type": {
        "enum": [
          "CREATED", "NUDGE_SENT", "ESCALATION_DRAFTED", "FINAL_NOTICE_DRAFTED", "REPLY_RECEIVED", "SNOOZED",
          "RESOLVED", "EXPIRED", "CANCELLED"
        ]
      },
      "summary": { "type": "string" },
      "detail": { "type": ["string", "null"] },
      "occurredAt": { "type": "string", "format": "date-time" }
    }
  }
}
