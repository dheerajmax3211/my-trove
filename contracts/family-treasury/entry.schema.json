{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Family Treasury ledger entry (EntryView)",
  "description": "GET /v1/households/{id}/entries/{entryId}; also the body of deposit, transfer and reverse.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "householdId", "kind", "description", "postedAt", "reversesEntryId", "approvalId", "createdByUid", "postings"],
  "properties": {
    "id": { "type": "string" },
    "householdId": { "type": "string" },
    "kind": { "enum": ["DEPOSIT", "SPEND", "TRANSFER", "SPLIT", "REVERSAL", "ALLOWANCE"] },
    "description": { "type": "string" },
    "postedAt": { "type": "string", "format": "date-time" },
    "reversesEntryId": { "type": ["string", "null"] },
    "approvalId": { "type": ["string", "null"] },
    "createdByUid": { "type": "string" },
    "postings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["accountId", "amountMinor", "currency"],
        "properties": { "accountId": { "type": "string" }, "amountMinor": { "type": "integer" }, "currency": { "type": "string" } }
      }
    }
  }
}
