{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Digital Legacy timeline (OwnerDtos.TimelineEntry[])",
  "description": "GET /v1/legacy/vault/timeline.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["seq", "at", "actorKind", "eventType", "detail"],
    "properties": {
      "seq": { "type": "integer" },
      "at": { "type": "string", "format": "date-time" },
      "actorKind": { "type": "string" },
      "eventType": { "type": "string" },
      "detail": { "type": "object" }
    }
  }
}
